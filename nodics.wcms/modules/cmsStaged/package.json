{
  "name": "cmsStaged",
  "version": "0.0.0",
  "description": "Nodics CMS Staged runtime schema and versioning capability.",
  "index": "50.21",
  "private": true,
  "main": "nodics.js",
  "requiredModules": [
    "cms",
    "vDatabase",
    "vMongodb",
    "vService"
  ],
  "nodics": {
    "kind": "publish",
    "extends": [
      "cms"
    ],
    "runtimeModule": true,
    "loadableByNodicsModuleLoader": true,
    "owns": [
      "configuration",
      "schema",
      "test",
      "llm"
    ],
    "runtime": {
      "router": false,
      "publish": true,
      "web": false
    },
    "displayName": "CMS Staged Versioning"
  }
}
