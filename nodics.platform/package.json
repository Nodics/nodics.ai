{
  "name": "nodics.platform",
  "version": "0.0.1",
  "index": "60.99",
  "private": true,
  "description": "Nodics platform module group.",
  "main": "nodics.js",
  "requiredModules": [
    "profile",
    "backoffice",
    "axis"
  ],
  "nodics": {
    "kind": "group",
    "extends": [
      "nodics.core"
    ],
    "runtimeModule": true,
    "loadableByNodicsModuleLoader": true,
    "owns": [
      "composition",
      "configuration",
      "llm"
    ],
    "runtime": {
      "router": false,
      "publish": false,
      "web": false
    },
    "displayName": "Nodics Platform",
    "functionalModule": {
      "identity": "nodics.platform",
      "displayName": "Platform",
      "type": "STANDARD",
      "protected": true
    }
  },
  "scripts": {
    "check:syntax": "find . -name '*.js' -not -path './node_modules/*' -print0 | xargs -0 -n 50 node --check",
    "test:axis": "npm --prefix modules/axis test",
    "test:documentation": "node modules/backoffice/test/backofficeDocumentationNavigationContract.test.js",
    "test:functional-catalogue": "node modules/backoffice/test/functionalModuleCatalogueService.test.js",
    "test": "npm run check:syntax && npm run test:axis && npm run test:documentation && npm run test:functional-catalogue"
  }
}
