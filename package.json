{
  "name": "nodics.ai",
  "version": "0.0.1",
  "private": true,
  "description": "Nodics backend framework repository containing standard functional module groups.",
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": ">=22 <27",
    "npm": ">=10 <12"
  },
  "nodics": {
    "kind": "framework",
    "runtimeModule": false,
    "loadableByNodicsModuleLoader": false,
    "owns": [
      "repository",
      "documentation",
      "llm",
      "release"
    ],
    "runtime": {
      "router": false,
      "publish": false,
      "web": false
    },
    "displayName": "Nodics AI Framework"
  },
  "workspaces": [
    "nodics.core",
    "nodics.platform",
    "nodics.cron",
    "nodics.wcms",
    "nodics.docs"
  ],
  "scripts": {
    "validate:root": "node scripts/validate-framework-root.js",
    "test": "npm run validate:root"
  }
}
