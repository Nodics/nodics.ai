{
    "name": "localizationCore",
    "index": "40.10",
    "description": "Persisted localization policy, translation contract, and publication-adapter capability.",
    "main": "nodics.js",
    "version": "0.0.0",
    "private": true,
    "license": "SEE LICENSE IN LICENSE",
    "nodics": {
        "kind": "capability",
        "displayName": "Localization Core",
        "runtimeModule": true,
        "loadableByNodicsModuleLoader": true,
        "owns": [
            "configuration",
            "data",
            "schema",
            "router",
            "service",
            "pipeline",
            "interceptor",
            "event",
            "search",
            "utility",
            "test",
            "llm"
        ],
        "runtime": {
            "router": false,
            "publish": true,
            "web": false
        }
    },
    "scripts": {
        "check:syntax": "find . -name '*.js' -not -path './node_modules/*' -print0 | xargs -0 -n 50 node --check",
        "test": "npm run check:syntax && node test/localizationRegistryReleaseContract.test.js && node test/localizationOperationsContract.test.js"
    }
}
