{
    "name": "wasteRecycling",
    "index": "92.72",
    "description": "Reusable recycling and recycler/logistics handoff accelerator contracts for nodics.waste.",
    "main": "nodics.js",
    "version": "0.0.0",
    "private": true,
    "license": "SEE LICENSE IN LICENSE",
    "nodics": {
        "kind": "capability",
        "displayName": "Waste Recycling",
        "runtimeModule": true,
        "loadableByNodicsModuleLoader": true,
        "owns": [
            "configuration",
            "source",
            "test",
            "llm"
        ],
        "runtime": {
            "router": false,
            "publish": false,
            "web": false
        },
        "extends": [
            "nodics.waste"
        ]
    },
    "scripts": {
        "check:syntax": "find . -name '*.js' -not -path './node_modules/*' -print0 | xargs -0 -n 50 node --check",
        "test:contract": "for file in test/*.test.js; do node \"$file\" || exit 1; done",
        "test": "npm run check:syntax && npm run test:contract"
    }
}
