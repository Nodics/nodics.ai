{
  "name": "eWaste",
  "index": "92.71",
  "description": "Reusable electronic-waste taxonomy, policies and customer journey orchestration over nodics.waste.",
  "main": "nodics.js",
  "version": "0.0.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "nodics": {
    "kind": "capability",
    "displayName": "E-Waste",
    "runtimeModule": true,
    "loadableByNodicsModuleLoader": true,
    "owns": [
      "configuration",
      "data",
      "test",
      "llm",
      "composition",
      "service",
      "schema",
      "router",
      "controller",
      "utility"
    ],
    "runtime": {
      "router": true,
      "publish": false,
      "web": false
    },
    "extends": [
      "nodics.waste"
    ]
  },
  "scripts": {
    "test:contract": "for file in test/*.test.js; do node \"$file\" || exit 1; done",
    "test": "npm run test:contract"
  }
}
