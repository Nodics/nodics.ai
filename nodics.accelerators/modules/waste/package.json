{
    "name": "waste",
    "index": "92.79",
    "description": "Waste Management accelerator umbrella for scenario-specific waste presets.",
    "main": "nodics.js",
    "requiredModules": [
        "eWaste",
        "wasteRecycling",
        "circa.eWaste"
    ],
    "version": "0.0.0",
    "private": true,
    "license": "SEE LICENSE IN LICENSE",
    "nodics": {
        "kind": "group",
        "displayName": "Waste",
        "runtimeModule": true,
        "loadableByNodicsModuleLoader": true,
        "owns": [
            "composition",
            "configuration",
            "llm",
            "test"
        ],
        "runtime": {
            "router": false,
            "publish": false,
            "web": false
        },
        "extends": [
            "nodics.waste"
        ]
    },
    "scripts": {
        "check:syntax": "find . -name '*.js' -not -path './node_modules/*' -print0 | xargs -0 -n 50 node --check",
        "test:contract": "for file in test/*.test.js modules/*/test/*.test.js; do node \"$file\" || exit 1; done",
        "test": "npm run check:syntax && npm run test:contract"
    }
}
