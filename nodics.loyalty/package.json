{
    "name": "nodics.loyalty",
    "index": "80.99",
    "description": "Nodics Loyalty functional module group.",
    "main": "nodics.js",
    "version": "0.0.0",
    "private": true,
    "license": "SEE LICENSE IN LICENSE",
    "requiredModules": [
        "loyaltyCore",
        "loyaltyProgram",
        "loyaltyRewardType",
        "loyaltyWallet",
        "loyaltyLedger",
        "loyaltyReservation",
        "loyaltyRedemption",
        "loyaltyApi"
    ],
    "nodics": {
        "kind": "group",
        "displayName": "Nodics Loyalty",
        "extends": [
            "nodics.foundation"
        ],
        "runtimeModule": true,
        "loadableByNodicsModuleLoader": true,
        "owns": [
            "composition",
            "configuration",
            "test",
            "llm"
        ],
        "runtime": {
            "router": false,
            "publish": false,
            "web": false
        },
        "functionalModule": {
            "identity": "nodics.loyalty",
            "displayName": "Loyalty",
            "type": "STANDARD",
            "protected": false
        }
    },
    "scripts": {
        "check:syntax": "find . -name '*.js' -not -path './node_modules/*' -print0 | xargs -0 -n 50 node --check",
        "test:contract": "for file in test/*.test.js modules/*/test/*.test.js; do node \"$file\" || exit 1; done",
        "test": "npm run check:syntax && npm run test:contract"
    }
}
