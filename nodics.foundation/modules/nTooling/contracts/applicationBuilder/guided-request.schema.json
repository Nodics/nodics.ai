{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.nodics.com/application-builder/v1/guided-request.schema.json",
  "title": "Nodics Application Builder guided request",
  "description": "Beginner-facing answers used to create a governed Builder solution and plan.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "project", "preset", "market", "frontends", "sampleData"],
  "properties": {
    "contractVersion": { "const": 1 },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectCode", "customerCode"],
      "properties": {
        "projectCode": { "$ref": "#/$defs/code" },
        "customerCode": { "$ref": "#/$defs/code" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 120 }
      }
    },
    "preset": { "enum": ["commerce", "apparel", "electronics", "telco", "combined"] },
    "market": {
      "type": "object",
      "additionalProperties": false,
      "required": ["country", "locale", "currency"],
      "properties": {
        "country": { "type": "string", "pattern": "^[A-Z]{2}$" },
        "locale": { "type": "string", "pattern": "^[a-z]{2}(?:-[A-Z]{2})?$" },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" }
      }
    },
    "frontends": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["AGORA", "AXIS", "NEXUS"] }
    },
    "sampleData": { "type": "boolean" },
    "outputRoot": { "type": "string", "minLength": 1, "maxLength": 512 },
    "approvalReference": { "type": "string", "minLength": 1, "maxLength": 200 }
  },
  "$defs": {
    "code": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._-]{1,127}$" }
  }
}
