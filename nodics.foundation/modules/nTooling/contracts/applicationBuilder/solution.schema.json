{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.nodics.com/application-builder/v1/solution.schema.json",
  "title": "Nodics Application Builder solution",
  "description": "Declarative, secret-free input for deterministic Nodics customer-application planning.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "identity", "environment", "capabilities", "commerce", "topology", "experience", "security", "integrations", "data", "qualification", "decisions"],
  "properties": {
    "contractVersion": { "const": 1 },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["solutionCode", "customerCode", "projectCode"],
      "properties": {
        "solutionCode": { "$ref": "#/$defs/code" },
        "customerCode": { "$ref": "#/$defs/code" },
        "projectCode": { "$ref": "#/$defs/code" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 120 }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "class"],
      "properties": {
        "mode": { "enum": ["WORKSPACE", "REGISTRY"] },
        "class": { "enum": ["LOCAL", "DEVELOPMENT", "TEST", "STAGING", "PRODUCTION"] },
        "deploymentShape": { "enum": ["MODULAR_PROCESSES", "CONSOLIDATED"] }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selected", "domains"],
      "properties": {
        "selected": { "type": "array", "items": { "$ref": "#/$defs/capabilityCode" }, "uniqueItems": true, "minItems": 1 },
        "domains": { "type": "array", "items": { "enum": ["APPAREL", "ELECTRONICS", "TELCO"] }, "uniqueItems": true },
        "excluded": { "type": "array", "items": { "$ref": "#/$defs/capabilityCode" }, "uniqueItems": true, "default": [] }
      }
    },
    "commerce": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stores", "catalogs", "locales", "currencies"],
      "properties": {
        "stores": { "$ref": "#/$defs/nonEmptyCodes" },
        "catalogs": { "$ref": "#/$defs/nonEmptyCodes" },
        "locales": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z]{2}(?:-[A-Z]{2})?$" } },
        "currencies": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Z]{3}$" } },
        "markets": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Z]{2}$" } }
      }
    },
    "topology": {
      "type": "object",
      "additionalProperties": false,
      "required": ["backendRuntimes", "frontends"],
      "properties": {
        "backendRuntimes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["PLATFORM", "WCMS_STAGED", "WCMS_ONLINE", "PROCESS", "ENGAGEMENT", "COMMERCE"] } },
        "frontends": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["AXIS", "NEXUS", "AGORA"] } }
      }
    },
    "experience": {
      "type": "object",
      "additionalProperties": false,
      "required": ["storefront", "composition", "routes", "rendererKeys"],
      "properties": {
        "storefront": { "const": "AGORA" },
        "composition": { "enum": ["commerce", "apparel", "electronics", "telco", "combined"] },
        "routes": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/route" } },
        "rendererKeys": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/capabilityCode" } },
        "themeCode": { "$ref": "#/$defs/code" }
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authentication", "authorization", "session", "corsOrigins", "publicApiCategories"],
      "properties": {
        "authentication": { "enum": ["PASSWORD", "OIDC", "SAML", "PASSWORD_AND_OIDC"] },
        "authorization": { "const": "BACKEND_OWNED" },
        "session": { "enum": ["BEARER", "SECURE_BROWSER_SESSION"] },
        "corsOrigins": { "type": "array", "uniqueItems": true, "items": { "type": "string", "format": "uri", "pattern": "^https?://" } },
        "publicApiCategories": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/code" } }
      }
    },
    "integrations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "kind", "certificationState"],
        "properties": {
          "code": { "$ref": "#/$defs/code" },
          "kind": { "enum": ["PAYMENT", "FULFILLMENT", "PROVISIONING", "IDENTITY", "MESSAGING", "TAX", "OTHER"] },
          "certificationState": { "enum": ["LOCAL_ADAPTER", "SANDBOX_CERTIFIED", "PRODUCTION_CERTIFIED", "PARKED"] },
          "secretReference": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:/-]{2,255}$" },
          "required": { "type": "boolean", "default": false }
        }
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["packs", "customerOwnedRoots"],
      "properties": {
        "packs": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/capabilityCode" } },
        "customerOwnedRoots": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/safeRelativePath" } },
        "sampleData": { "type": "boolean", "default": false }
      }
    },
    "qualification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "journeys", "freshDatabaseRequired"],
      "properties": {
        "profile": { "enum": ["CONTRACT", "LOCAL_END_TO_END", "RELEASE"] },
        "journeys": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/capabilityCode" } },
        "freshDatabaseRequired": { "type": "boolean" },
        "browserRequired": { "type": "boolean", "default": true }
      }
    },
    "decisions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unresolved", "assumptions"],
      "properties": {
        "unresolved": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 500 } },
        "assumptions": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 500 } }
      }
    }
  },
  "$defs": {
    "code": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._-]{1,127}$" },
    "capabilityCode": { "type": "string", "pattern": "^[a-z][A-Za-z0-9._-]{1,127}$" },
    "nonEmptyCodes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/code" } },
    "route": { "type": "string", "pattern": "^/(?!/)(?:[A-Za-z0-9._~!$&'()*+,;=:@%/-]*)$" },
    "safeRelativePath": { "type": "string", "minLength": 1, "maxLength": 512, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[A-Za-z0-9._/-]+$" }
  }
}
