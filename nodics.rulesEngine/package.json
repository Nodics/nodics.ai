{
  "name": "nodics.rulesEngine",
  "version": "0.0.0",
  "index": "84.99",
  "private": true,
  "description": "Nodics generic governed business rules evaluation functional module group.",
  "main": "nodics.js",
  "requiredModules": [
    "rulesCore",
    "rulesDefinition",
    "rulesEvaluation",
    "rulesApi"
  ],
  "license": "SEE LICENSE IN LICENSE",
  "nodics": {
    "kind": "group",
    "displayName": "Nodics Rules Engine",
    "runtimeModule": true,
    "loadableByNodicsModuleLoader": true,
    "owns": [
      "composition",
      "configuration",
      "test",
      "llm"
    ],
    "runtime": {
      "router": false,
      "publish": false,
      "web": false
    },
    "extends": [
      "nodics.foundation"
    ],
    "functionalModule": {
      "identity": "nodics.rulesEngine",
      "displayName": "Rules Engine",
      "type": "STANDARD",
      "protected": false
    }
  },
  "scripts": {
    "check:syntax": "find . -name '*.js' -not -path './node_modules/*' -print0 | xargs -0 -n 50 node --check",
    "test:contract": "for file in test/*.test.js modules/*/test/*.test.js; do if [ -f \"$file\" ]; then node \"$file\" || exit 1; fi; done",
    "test": "npm run check:syntax && npm run test:contract"
  }
}
