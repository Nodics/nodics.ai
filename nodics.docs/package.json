{
  "name": "nodics.docs",
  "version": "0.0.0",
  "index": "95.99",
  "private": true,
  "main": "nodics.js",
  "description": "Versioned documentation content for Nodics functional modules.",
  "nodics": {
    "kind": "group",
    "runtimeModule": true,
    "loadableByNodicsModuleLoader": true,
    "owns": [
      "composition",
      "configuration",
      "data",
      "documentation",
      "llm"
    ],
    "runtime": {
      "router": false,
      "publish": false,
      "web": false
    },
    "displayName": "Nodics Documentation"
  },
  "scripts": {
    "docs:generate": "node scripts/generate-content-pack.mjs",
    "docs:check": "node scripts/generate-content-pack.mjs --check",
    "validate": "node scripts/validate.mjs",
    "test": "npm run docs:check && npm run validate"
  },
  "files": [
    "docs",
    "data/core",
    "manifest"
  ]
}
